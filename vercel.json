{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@10.28.0 install --frozen-lockfile --filter @clavis/web...",
  "buildCommand": "npx --yes pnpm@10.28.0 --filter @clavis/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
