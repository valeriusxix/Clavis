# --- mode ---
DEMO_MODE=true                    # true = seeded traders, demo account, no keys needed
NETWORK=testnet                   # contract network (testnet default)

# --- 1Click (optional in demo mode) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=                 # X-API-Key from https://partners.near-intents.org (without it an extra fee applies)

# --- NEAR contract ---
CLAVIS_CONTRACT_ID=clavis-app.testnet  # the deployed Clavis contract; reading it needs no key
COMMITTER_ACCOUNT_ID=             # account allowed to call commit_log
COMMITTER_PRIVATE_KEY=            # ed25519:... NEVER COMMIT
NEAR_RPC_URL=                     # public RPC from docs.near.org/api/rpc/providers

# --- demo traders on testnet (operator only; see docs/SEEDING.md) ---
SEED_ACCOUNT_PARENT=clavis-app.testnet  # demo traders are <handle>[-<version>].<parent>
SEED_ACCOUNT_VERSION=             # e.g. v2: fresh accounts after the seeded logs change
SEED_PARENT_PRIVATE_KEY=          # only for `pnpm seed:chain`: full-access key of the parent. NEVER COMMIT

# --- real mode (operator only; leave empty for the demo) ---
REAL_TRADER_ID=                   # testnet trader identity for real trades, e.g. real-trader.clavis-app.testnet
REAL_TRADER_MAINNET_ACCOUNT=      # the only mainnet account allowed to place real trades as REAL_TRADER_ID
REAL_TRADE_MAX_USD=4              # hard cap per real trade (max 4)

# --- server ---
PORT=8787
HOST=                             # listen address; default 0.0.0.0 (needed by most hosts), 127.0.0.1 = this machine only
SESSION_SECRET=
DATABASE_PATH=./data/clavis.db
WEB_ORIGIN=http://localhost:5173  # browser origin(s) allowed to call the API (comma-separated)

# --- web (Vite exposes VITE_*) ---
VITE_API_URL=http://localhost:8787
VITE_NETWORK=testnet
VITE_CLAVIS_CONTRACT_ID=clavis-app.testnet
